{
  "name": "brewthink-web-simulator",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "wasm": "../scripts/build-web-wasm.sh",
    "wasm:release": "../scripts/build-web-wasm.sh --release",
    "dev": "bun run wasm && vite --host 127.0.0.1",
    "build": "bun run wasm:release && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
